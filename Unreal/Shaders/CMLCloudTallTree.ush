// Port of Assets/_Project/Art/Environment/StarterIsland/Shaders/
// StarterIslandCloudTallTree.shader
//
// The CloudTall trees carry their painted colour in the mesh vertex colour and
// keep the maps in luminance only, so one shader serves the opaque crown, the
// opaque trunk and the alpha clipped leaf clusters.
//
// All maths below runs in Unity space (Y-up, metres); the caller converts the
// returned offset back to Unreal space.

#pragma once

#include "/CML/CMLMaterialCommon.ush"

/**
 * Unity's GetWindPositionWS, returned as a displacement instead of a position.
 * Every Unity pass called the identical deformation so the foliage, its depth
 * and its projected shadow stayed coincident; in Unreal the single World
 * Position Offset output gives that property for free.
 */
float3 CMLCloudTallWindOffset(
    float3 UnityPositionWS,
    float3 UnityObjectOriginWS,
    float3 UnityPositionOS,
    float2 UnityUV,
    float TimeSeconds,
    float3 WindDirection,
    float WindStrength,
    float WindSpeed,
    float WindGustStrength,
    float WindFlutterStrength,
    float WindBaseHeight,
    float WindHeight)
{
    float2 Direction = WindDirection.xz;
    Direction *= rsqrt(max(dot(Direction, Direction), 0.0001f));
    float2 CrossDirection = float2(-Direction.y, Direction.x);

    float HeightWeight = smoothstep(
        WindBaseHeight,
        WindBaseHeight + max(WindHeight, 0.001f),
        UnityPositionOS.y);

    float ObjectPhase = dot(UnityObjectOriginWS.xz, float2(0.037f, 0.053f));
    float TravelPhase = dot(UnityPositionWS.xz, float2(0.063f, 0.041f));
    float MainSway = sin(TimeSeconds * WindSpeed + TravelPhase + ObjectPhase);
    float Gust = sin(
        TimeSeconds * (WindSpeed * 0.37f) + ObjectPhase * 1.73f + TravelPhase * 0.23f);
    float Flutter = sin(
        TimeSeconds * (WindSpeed * 2.8f) +
        UnityPositionOS.x * 1.31f +
        UnityPositionOS.z * 1.67f +
        (UnityUV.x + UnityUV.y) * 5.1f +
        ObjectPhase);

    float SwayAmount = (MainSway + Gust * WindGustStrength) * WindStrength * HeightWeight;
    float FlutterAmount = Flutter * WindFlutterStrength * HeightWeight;

    float3 Offset = float3(0.0f, 0.0f, 0.0f);
    Offset.xz += Direction * SwayAmount;
    Offset.xz += CrossDirection * FlutterAmount;
    Offset.y += abs(MainSway) * WindStrength * HeightWeight * 0.035f;
    return Offset;
}

float CMLChopSectorRadius(int Sector)
{
    if (Sector == 0) return 0.91f;
    if (Sector == 1) return 1.06f;
    if (Sector == 2) return 0.94f;
    if (Sector == 3) return 1.09f;
    if (Sector == 4) return 0.96f;
    if (Sector == 5) return 1.03f;
    if (Sector == 6) return 0.89f;
    if (Sector == 7) return 1.07f;
    if (Sector == 8) return 0.93f;
    if (Sector == 9) return 1.04f;
    if (Sector == 10) return 0.90f;
    return 1.01f;
}

float CMLChopNormalizedRadius(float NX, float NY)
{
    float EndBlend = smoothstep(0.58f, 1.0f, abs(NX));
    float AvailableHalfHeight = lerp(1.0f, 0.24f, EndBlend);
    float ShapedY = NY / AvailableHalfHeight;
    float SectorFloat = clamp((atan2(ShapedY, NX) + 3.14159265f) * 1.90985932f, 0.0f, 11.9999f);
    int Sector = (int)floor(SectorFloat);
    int Next = Sector == 11 ? 0 : Sector + 1;
    float RadiusLimit = lerp(
        CMLChopSectorRadius(Sector), CMLChopSectorRadius(Next), frac(SectorFloat));
    float AsymmetricReach = lerp(0.90f, 1.06f, saturate(NX * 0.5f + 0.5f));
    return length(float2(NX, ShapedY)) / (RadiusLimit * AsymmetricReach);
}

/**
 * Wound shading for vertices generated by TreeChopVoxelCarver. Only those carry
 * the out-of-band +16 marker in chopData.w, so authored canopy vertex data can
 * never enter the wound shading.
 */
float3 CMLApplyChopAppearance(float3 BarkAlbedo, float4 ChopData)
{
    if (ChopData.w < 16.5f)
    {
        return BarkAlbedo;
    }

    float MaterialId = ChopData.w - 16.0f;
    if (ChopData.z < -0.05f)
    {
        // Negative voxel depth marks a connected bark tongue. Keeping this flag
        // independent from the interpolated material id makes the small flap
        // remain legible at its tapered edges.
        float FlapCore = smoothstep(0.12f, 0.45f, saturate(-ChopData.z));
        float3 WarmUnderside = float3(0.48f, 0.24f, 0.10f);
        float3 BarkFace = lerp(float3(0.74f, 0.69f, 0.56f), BarkAlbedo, 0.45f);
        return saturate(lerp(WarmUnderside, BarkFace, FlapCore));
    }

    if (MaterialId < 0.5f)
    {
        return BarkAlbedo;
    }

    if (MaterialId > 3.5f)
    {
        // A generated flap keeps the authored bark sample.
        return BarkAlbedo;
    }

    float NX = ChopData.x;
    float NY = ChopData.y;
    float Depth01 = saturate(ChopData.z);

    // The cambium is a narrow physical wall between unchanged birch bark and
    // generated wood; no spatial mask can bleed onto intact bark.
    float3 Cambium = float3(1.00f, 0.70f, 0.39f);
    if (MaterialId < 1.5f)
    {
        float CambiumFiber = sin(NX * 42.0f - NY * 7.0f) * 0.5f + 0.5f;
        float3 CambiumAppearance = Cambium * lerp(0.98f, 1.02f, CambiumFiber);
        float Reveal = smoothstep(0.48f, 1.42f, MaterialId);
        return lerp(BarkAlbedo, CambiumAppearance, Reveal * 0.92f);
    }

    // Fresh wood is one continuous material: geometric voxel depth and short
    // fibres provide variation without separate circular stamps or bands.
    float3 LightWood = float3(1.00f, 0.72f, 0.42f);
    float3 BaseWood = float3(0.88f, 0.55f, 0.30f);
    float3 DeepWood = float3(0.72f, 0.40f, 0.20f);
    float3 WarmWood = float3(0.94f, 0.62f, 0.35f);
    float3 Wood = LightWood;
    Wood = lerp(Wood, BaseWood, step(2.10f, MaterialId));
    Wood = lerp(Wood, DeepWood, step(2.30f, MaterialId));
    Wood = lerp(Wood, WarmWood, step(2.50f, MaterialId));
    Wood *= lerp(1.05f, 0.98f, Depth01);

    // Short, broken fibres only: their vertical window changes every 8-18 mm,
    // preventing long uniform pinstripes while retaining the fibrous read.
    float Fiber = sin(NX * 38.0f + sin(NY * 11.0f) * 1.2f) * 0.5f + 0.5f;
    float FiberWindow = smoothstep(0.28f, 0.62f, sin(NY * 18.0f - NX * 4.0f) * 0.5f + 0.5f);
    float CrossGrain = sin(NX * 19.0f - NY * 7.0f) * 0.5f + 0.5f;
    float BroadFacet = sin(NX * 5.1f + NY * 3.4f + sin(NY * 7.0f) * 0.7f) * 0.5f + 0.5f;
    Wood = lerp(Wood * 0.92f, Wood * 1.10f, smoothstep(0.28f, 0.72f, BroadFacet));
    Wood *= lerp(0.96f, 1.04f, lerp(CrossGrain, Fiber, FiberWindow));

    if (MaterialId > 2.90f)
    {
        Wood = lerp(Wood, float3(0.25f, 0.12f, 0.055f), 0.38f);
    }

    return Wood;
}

/** Unity used a fixed 0.12 smoothness on wound surfaces, bark used _Smoothness. */
float CMLChopSmoothness(float4 ChopData, float BaseSmoothness)
{
    return ChopData.w > 16.5f ? 0.12f : BaseSmoothness;
}
