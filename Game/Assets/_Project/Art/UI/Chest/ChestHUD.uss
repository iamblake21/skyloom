/* Crate panel — the new parts only.
 *
 * The surface, the hairlines, the typography and every slot come from InventoryHUD.uss,
 * which the controller applies alongside this sheet.
 *
 * No rounded corners with overflow clipping on thin elements anywhere here: on a 5 px
 * box that combination made UI Toolkit draw the machine panel's progress track as opaque
 * white while resolvedStyle still reported the right colour. Cheap to avoid, invisible
 * when it bites.
 */

.chest-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: rgb(242, 227, 192);
}

.chest-panel {
    display: none;
    width: 720px;
    flex-direction: column;
    align-self: center;
}

.chest-columns {
    flex-direction: row;
}

/* Two columns of equal width with a hairline between them: the crate is not more
   important than the backpack, and a divider is cheaper than a second panel. */
.chest-column {
    width: auto;
    height: auto;
    min-width: 0;
    flex-grow: 1;
    flex-basis: 0;
    padding-left: 12px;
    padding-right: 12px;
}

.chest-column--player {
    border-left-width: 1px;
    border-left-color: rgba(242, 227, 192, 0.10);
}

.chest-grid {
    flex-wrap: wrap;
    justify-content: flex-start;
    align-content: flex-start;
}

.chest-slot {
    flex-shrink: 0;
    width: 58px;
    height: 58px;
    margin-right: 6px;
    margin-bottom: 6px;
}

/* A crate slot is clickable, so it says so on hover. The inventory's own hover rule
   already lightens the glass; this only adds the cursor affordance of a lifted edge. */
.chest-slot:hover {
    border-top-color: rgba(237, 194, 87, 0.45);
}

.chest-footer {
    margin-top: 8px;
    padding-top: 9px;
    border-top-width: 1px;
    border-top-color: rgba(242, 227, 192, 0.10);
}

/* The status line reports a refusal by its cause. It stays empty when nothing was
   refused rather than saying "pronto", which would be noise. */
.chest-status {
    color: rgba(238, 168, 148, 0.95);
    font-size: 10px;
    letter-spacing: 0.4px;
}

.chest-panel--open {
    display: flex;
}

.chest-screen {
    color: rgb(255, 255, 255);
}
